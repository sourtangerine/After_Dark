{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug SFML App",
      "type": "cppdbg",
      "request": "launch",
      "program": "C:\\After_Dark\\main.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "C:\\After_Dark",
      "environment": [
        {
          "name": "PATH",
          "value": "C:\\SFML-3.1.0\\bin;${env:PATH}"
        }
      ],
      "externalConsole": true,
      "MIMode": "gdb",
      "miDebuggerPath": "C:\\mingw64\\bin\\gdb.exe",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "description": "Set Disassembly Flavor to Intel",
          "text": "-gdb-set disassembly-flavor intel",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "C/C++: g++.exe build active file"
    }
  ]
}
